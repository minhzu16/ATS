# ==========================================
# Applicant Tracking System (ATS) Environment Variables
# Copy this file to .env or set variables in your deployment environment
# ==========================================

# Server Configuration
SERVER_PORT=8386
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/applicant_tracking?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_secure_db_password

# JWT Security (Must be at least 64 characters / 512 bits for HS512)
JWT_SECRET_KEY=generate_a_random_secure_secret_key_with_at_least_64_characters_long_1234567890
JWT_ACCESS_TOKEN_EXPIRATION_MS=3600000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# Mail Server Configuration (SMTP)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password
MAIL_FROM=noreply@ats-system.com

# Frontend and CORS
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Seeding & Bootstrap Admin (Dev only)
APP_SEED_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@ats.com
BOOTSTRAP_ADMIN_PASSWORD=your_secure_admin_password
