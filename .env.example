# Variables for `docker compose up`. Copy to .env (gitignored) and fill in every value:
# compose refuses to start while any of them is empty.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# HS512 signing key, at least 64 characters
JWT_SECRET_KEY=

# Password (12+ characters) shared by the accounts the dev profile seeds (admin, HR, interviewer).
# Compose runs the dev profile, i.e. a demo stack with sample data; production should run without it.
BOOTSTRAP_ADMIN_PASSWORD=
